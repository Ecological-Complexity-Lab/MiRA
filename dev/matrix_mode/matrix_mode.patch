 mapModeBtn.addEventListener('click', toggleMapMode);
 
+// ---- Matrix (SAM) Mode Logic ----
+let _matrixHandlers = null; // { mousedown, mousemove, mouseup, wheel }
+
+function toggleMatrixMode() {
+    if (!model) return;
+    if (appMode === 'matrix') {
+        _exitMatrixMode();
+        appMode = 'network';
+        renderer.render();
+    } else {
+        if (appMode === 'map') toggleMapMode();
+        appMode = 'matrix';
+        renderer.matrixView = new MatrixView(model);
+        renderer.matrixMode = true;
+        matrixModeBtn.classList.add('active');
+        canvas.style.cursor = 'grab';
+
+        // --- Drag state ---
+        let isDragging = false;
+        let dragStartX = 0, dragStartY = 0;
+        let offsetStartX = 0, offsetStartY = 0;
+
+        const canvasCoords = (e) => {
+            const rect = canvas.getBoundingClientRect();
+            return {
+                mx: (e.clientX - rect.left) * (canvas.width  / rect.width),
+                my: (e.clientY - rect.top)  * (canvas.height / rect.height),
+            };
+        };
+
+        const onMouseDown = (e) => {
+            if (e.button !== 0) return;
+            isDragging    = true;
+            dragStartX    = e.clientX;
+            dragStartY    = e.clientY;
+            offsetStartX  = renderer.matrixView.viewOffsetX;
+            offsetStartY  = renderer.matrixView.viewOffsetY;
+            canvas.style.cursor = 'grabbing';
+        };
+
+        const onMouseMove = (e) => {
+            if (isDragging) {
+                renderer.matrixView.viewOffsetX = offsetStartX + (e.clientX - dragStartX);
+                renderer.matrixView.viewOffsetY = offsetStartY + (e.clientY - dragStartY);
+                renderer.render();
+                tooltip.classList.remove('visible');
+                return;
+            }
+            // Hover tooltip
+            const { mx, my } = canvasCoords(e);
+            const hit = renderer.matrixView.hitTest(mx, my, canvas.width, canvas.height);
+            if (hit) {
+                const label = hit.fromLayer === hit.toLayer
+                    ? `${hit.fromNode} — ${hit.toNode} (${hit.fromLayer})`
+                    : `${hit.fromNode} (${hit.fromLayer}) ↔ ${hit.toNode} (${hit.toLayer})`;
+                tooltip.textContent = label;
+                tooltip.classList.add('visible');
+                tooltip.style.left = (e.clientX + 14) + 'px';
+                tooltip.style.top  = (e.clientY - 8)  + 'px';
+            } else {
+                tooltip.classList.remove('visible');
+            }
+        };
+
+        const onMouseUp = () => {
+            isDragging = false;
+            canvas.style.cursor = 'grab';
+        };
+
+        const onWheel = (e) => {
+            e.preventDefault();
+            const mv      = renderer.matrixView;
+            const factor  = e.deltaY > 0 ? 0.9 : 1.1;
+            const newScale = Math.min(Math.max(mv.viewScale * factor, 0.1), 80);
+
+            // Zoom centered on cursor
+            const { mx, my } = canvasCoords(e);
+            const margin   = 100;
+            const baseArea = mv._baseArea(canvas.width, canvas.height);
+            const matSize  = baseArea * mv.viewScale;
+            const matX     = margin + mv.viewOffsetX;
+            const matY     = margin + mv.viewOffsetY;
+
+            // Fraction of matrix under cursor
+            const fracX = (mx - matX) / matSize;
+            const fracY = (my - matY) / matSize;
+
+            const newMatSize    = baseArea * newScale;
+            mv.viewScale        = newScale;
+            mv.viewOffsetX      = mx - margin - fracX * newMatSize;
+            mv.viewOffsetY      = my - margin - fracY * newMatSize;
+            renderer.render();
+        };
+
+        canvas.addEventListener('mousedown', onMouseDown);
+        canvas.addEventListener('mousemove', onMouseMove);
+        canvas.addEventListener('mouseup',   onMouseUp);
+        canvas.addEventListener('wheel',     onWheel, { passive: false });
+        _matrixHandlers = { onMouseDown, onMouseMove, onMouseUp, onWheel };
+
+        renderer.render();
+    }
+}
+
+function _exitMatrixMode() {
+    renderer.matrixMode = false;
+    renderer.matrixView = null;
+    matrixModeBtn.classList.remove('active');
+    canvas.style.cursor = '';
+    tooltip.classList.remove('visible');
+    if (_matrixHandlers) {
+        canvas.removeEventListener('mousedown', _matrixHandlers.onMouseDown);
+        canvas.removeEventListener('mousemove', _matrixHandlers.onMouseMove);
+        canvas.removeEventListener('mouseup',   _matrixHandlers.onMouseUp);
+        canvas.removeEventListener('wheel',     _matrixHandlers.onWheel);
+        _matrixHandlers = null;
+    }
+}
+
+matrixModeBtn.addEventListener('click', toggleMatrixMode);
+
 function fitMapToLayers() {
